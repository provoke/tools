#!/usr/bin/env bash
#
# cleanup_codedeploy.sh
#
# Removes old CodeDeploy revision directories under a deployment-root,
# keeping the N most recent revisions (by mtime) per application, and
# always protecting the "last successful" and "most recent" install
# revisions from deletion regardless of age.
#
# Must be run as root (use sudo) since deployment-root is root-owned.
#
# Usage:
#   sudo bash cleanup_codedeploy.sh [-k KEEP_COUNT] [-r DEPLOY_ROOT] [-y]
#
#   -k KEEP_COUNT   Number of most recent revisions to keep per app (default: 3)
#   -r DEPLOY_ROOT  Path to CodeDeploy deployment-root
#                   (default: /opt/codedeploy-agent/deployment-root)
#   -y              Actually delete. Without this, runs as a dry-run.
#   -h              Show this help.

set -euo pipefail

KEEP=3
DEPLOY_ROOT="/opt/codedeploy-agent/deployment-root"
APPLY=false

usage() {
  cat <<USAGE
Usage: $0 [-k KEEP_COUNT] [-r DEPLOY_ROOT] [-y]
  -k KEEP_COUNT   Number of most recent revisions to keep per app (default: 3)
  -r DEPLOY_ROOT  CodeDeploy deployment-root path (default: $DEPLOY_ROOT)
  -y              Apply deletions (default is dry-run)
  -h              Show this help
USAGE
}

while getopts ":k:r:yh" opt; do
  case "$opt" in
    k) KEEP="$OPTARG" ;;
    r) DEPLOY_ROOT="$OPTARG" ;;
    y) APPLY=true ;;
    h) usage; exit 0 ;;
    \?) echo "Unknown option: -$OPTARG" >&2; usage; exit 1 ;;
    :) echo "Option -$OPTARG requires an argument" >&2; usage; exit 1 ;;
  esac
done

if [[ "$(id -u)" -ne 0 ]]; then
  echo "This script must be run as root (try: sudo bash $0 ...)" >&2
  exit 1
fi

if ! [[ "$KEEP" =~ ^[0-9]+$ ]] || [[ "$KEEP" -lt 1 ]]; then
  echo "KEEP_COUNT must be a positive integer" >&2
  exit 1
fi

if [[ ! -d "$DEPLOY_ROOT" ]]; then
  echo "Deployment root not found: $DEPLOY_ROOT" >&2
  exit 1
fi

INSTR_DIR="$DEPLOY_ROOT/deployment-instructions"

# Portable mtime getter: GNU stat vs BSD stat.
get_mtime() {
  if stat --version >/dev/null 2>&1; then
    stat -c '%Y' "$1"
  else
    stat -f '%m' "$1"
  fi
}

if $APPLY; then
  echo "Mode: LIVE (will delete)"
else
  echo "Mode: DRY-RUN (nothing will be deleted; re-run with -y to apply)"
fi
echo "Deployment root: $DEPLOY_ROOT"
echo "Keeping $KEEP most recent revision(s) per app"
echo

for app_dir in "$DEPLOY_ROOT"/*/; do
  app_dir="${app_dir%/}"
  app_id="$(basename "$app_dir")"

  case "$app_id" in
    deployment-instructions|deployment-logs|ongoing-deployment) continue ;;
  esac
  [[ -d "$app_dir" ]] || continue

  echo "App: $app_id"

  # Collect protected revision IDs (last successful / most recent install).
  protected=()
  for marker in last_successful_install most_recent_install; do
    marker_file="$INSTR_DIR/${app_id}_${marker}"
    if [[ -f "$marker_file" ]]; then
      rev_path="$(cat "$marker_file" 2>/dev/null || true)"
      [[ -n "$rev_path" ]] && protected+=("$(basename "$rev_path")")
    fi
  done

  # List revision dirs newest-first by mtime.
  revisions=()
  while IFS= read -r line; do
    revisions+=("${line#* }")
  done < <(
    for d in "$app_dir"/*/; do
      d="${d%/}"
      [[ -d "$d" ]] || continue
      printf '%s %s\n' "$(get_mtime "$d")" "$d"
    done | sort -rn
  )

  kept=0
  for rev_dir in "${revisions[@]}"; do
    rev_id="$(basename "$rev_dir")"

    is_protected=false
    for p in "${protected[@]:-}"; do
      if [[ "$rev_id" == "$p" ]]; then
        is_protected=true
        break
      fi
    done

    if $is_protected; then
      echo "  Keeping (protected): $rev_dir"
      continue
    fi

    kept=$((kept + 1))
    if [[ "$kept" -le "$KEEP" ]]; then
      echo "  Keeping ($kept/$KEEP): $rev_dir"
    elif $APPLY; then
      echo "  Removing: $rev_dir"
      rm -rf -- "$rev_dir"
    else
      echo "  Would remove (dry-run): $rev_dir"
    fi
  done
  echo
done

echo "Disk usage:"
df -h /
